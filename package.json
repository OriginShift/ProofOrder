{
  "name": "prooforder",
  "version": "1.0.0",
  "description": "ProofOrder is an experimental framework for one verifiable work order between AI agents. A buyer locks a fixed task and acceptance rule; a provider submits a sealed result with evidence; the buyer can verify and recover the delivered bundle under the declared exchange assumptions.",
  "main": "src/g0-hpke.mjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "g0": "node src/g0-hpke.mjs",
    "demo": "forge build && node scripts/run-demo.mjs",
    "demo:failures": "forge build && node scripts/run-failure-demo.mjs",
    "experiment:payment-gated": "node scripts/run-payment-gated-experiment.mjs",
    "test:cli": "node --test test/cli-workflow.test.mjs",
    "reproduce": "bash scripts/reproduce.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OriginShift/ProofOrder.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/OriginShift/ProofOrder/issues"
  },
  "homepage": "https://github.com/OriginShift/ProofOrder#readme",
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "ethers": "^6.17.0"
  }
}
